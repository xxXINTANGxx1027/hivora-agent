# ── 本地开发（server/.env，不入 git）─────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v3.2

# 不设 SECRET_KEY 时本地会用随机密钥（重启即退出登录），生产必须显式设置：
# SECRET_KEY=$(openssl rand -hex 32)
# SECRET_KEY=

# 本地默认 SQLite（server/hivora.db）；生产必须是 Postgres：
# DATABASE_URL=postgresql://...

# ── 生产必需（Render Environment）────────────────────────────
# HIVORA_ENV=production          # 打开启动守卫：缺关键配置直接拒绝启动
# ALLOWED_ORIGINS=https://hivora-frontend.vercel.app,https://hivora-admin.vercel.app
# ADMIN_EMAIL=                   # 首次部署创建管理员用
# ADMIN_PASSWORD=                # ≥10 位，不能是 admin123 之类

# ── Telegram（代理人自己的 bot）──────────────────────────────
# 必填，否则代理人连不了 bot：Telegram 要用它回调，必须是公网可达的后端域名
# 官方共享 Telegram bot（平台模式，代理人零配置接入）。
# 平台方在 @BotFather 建一个 bot（如 @HivoraAssistantBot），token 填这里。
# 不配的话代理人只能走「自建 bot」白牌模式。
# PLATFORM_BOT_TOKEN=7123456789:AAH...

# PUBLIC_BASE_URL=https://hivora-agent-stage.onrender.com
# TELEGRAM_TIMEOUT=10

# ── 开通邮件（admin 建完账号自动发登录信）────────────────────
# 不配就降级：账号照样建，只是管理站会把设密码链接摆出来让你手动转
#
# 通道 ①：Brevo —— 没有自己的域名时用这条。只需验证单个发件邮箱（收 6 位验证码），
#          验完就能发给任何人。免费 300 封/天。
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM=Hivora <你验证过的邮箱>
#
# 通道 ②：Resend —— 有域名之后的首选，送达率更好。
#          ⚠️ 没验证域名时只能发给你注册 Resend 的那个邮箱，发别人一律 403。
# RESEND_API_KEY=re_...
#
# 通道 ③：SMTP —— 退路。⚠️ Render 免费档封了出站 25/465/587（2025-09 起），
#          在免费实例上必然 connect 超时，要用得先升级付费。
# SMTP_HOST=smtp.gmail.com     # Gmail 要用应用专用密码，不是账号密码
# SMTP_PORT=587                # 465 会自动走 SSL
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Hivora <no-reply@hivora.my>       # 没设 MAIL_FROM 时回落到它
# APP_LOGIN_URL=https://hivora-frontend.vercel.app   # 设密码链接的落地页
# SETUP_LINK_HOURS=48            # 开通/重置链接的有效期
# DEFAULT_BRAND=Hivora           # 白牌：租户没设公司名时的回落

# ── 可观测性 ────────────────────────────────────────────────
# SENTRY_DSN=                    # 设了才启用；不设完全不引入 sentry
# SENTRY_TRACES=0.0              # 性能采样率，0 = 只报错误
# LOG_LEVEL=INFO
# SLOW_REQUEST_MS=3000           # 超过这个耗时的请求打 warning

# ── 成本与配额 ──────────────────────────────────────────────
# MONTHLY_TOKEN_QUOTA=2000000    # 每账号每月 token 上限（管理站可按账号覆盖）
# PRICE_PER_MTOK_IN=0.28         # 每百万输入 token 的美元单价，换模型记得改
# PRICE_PER_MTOK_OUT=0.42        # 每百万输出 token 的美元单价
# LLM_TIMEOUT=60                 # 单次模型调用超时（秒）
# LLM_RETRIES=2
# LLM_CONCURRENCY=8              # 同时在飞的模型调用上限

# ── 其他 ────────────────────────────────────────────────────
# TOKEN_TTL_DAYS=14              # 登录有效期
# LOGIN_LOCK_AFTER=5             # 连续失败多少次锁定
# LOGIN_LOCK_SECONDS=300
# LIST_CAP=500                   # 单次返回的最大条数
# MAX_UPLOAD_MB=20               # 条款文档上传上限
# TRASH_KEEP_DAYS=30             # 回收站保留天数（提示用，暂无自动清理）
# DEMO_DATA=0                    # 演示数据（假客户/假产品/示例条款）：生产默认关
