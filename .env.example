# ── 本地开发（server/.env，不入 git）─────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v3.2

# 不设 SECRET_KEY 时本地会用随机密钥（重启即退出登录），生产必须显式设置：
# SECRET_KEY=$(openssl rand -hex 32)
# SECRET_KEY=

# 本地默认 SQLite（server/hivora.db）；生产必须是 Postgres：
# DATABASE_URL=postgresql://...

# ── 以下只在生产（Render Environment）需要 ────────────────────
# HIVORA_ENV=production          # 打开启动守卫
# ALLOWED_ORIGINS=https://hivora-frontend.vercel.app
# ADMIN_EMAIL=                   # 首次部署创建管理员用
# ADMIN_PASSWORD=                # ≥10 位，不能是 admin123 之类
# TOKEN_TTL_DAYS=14              # 登录有效期
# MAX_UPLOAD_MB=20               # 条款文档上传上限
# DEMO_DATA=0                    # 演示数据（假客户/假产品/示例条款）：生产默认关
